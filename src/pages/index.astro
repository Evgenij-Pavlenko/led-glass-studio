---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';

const title = 'LED-GLASS Studio';
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <Hero />

    <main>
      <h1>LED-GLASS Studio</h1>
      <p>Die Welt ein kleines bisschen heller machen.</p>
    </main>
  </body>
</html>

<style>
  main {
    text-align: center;
    padding: 0 20px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 72px);
    margin-bottom: 20px;
  }

  p {
    color: #aaa;
    font-size: 20px;
  }
</style>
