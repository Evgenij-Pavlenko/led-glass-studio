---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';

const title = 'LED-GLASS Studio';
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon-ledg.ico" />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <Hero />

    <main>
      <section class="intro">
        <h1>LED-GLASS Studio</h1>

        <p class="slogan">Die Welt ein kleines bisschen heller machen.</p>

        <h2>Deine Idee. In Glas graviert. Mit Licht zum Leben erweckt.</h2>

        <p class="description">
          Individuelle Lichtkunst durch präzise Gravur auf Glas und Acrylglas. Jedes Werk verbindet
          persönliche Geschichten, einzigartige Motive und energiesparende LED-Beleuchtung.
        </p>

        <p class="description">
          Ob persönliche Geschenke, Erinnerungsstücke oder dekorative Kunstwerke - jede Idee wird zu
          einem besonderen Unikat.
        </p>
      </section>
      <ProjectShowcase />
    </main>
  </body>
</html>

<style>
  main {
    text-align: center;
    padding: 0 20px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 72px);
    margin-bottom: 20px;
  }

  p {
    color: #aaa;
    font-size: 20px;
  }
</style>
